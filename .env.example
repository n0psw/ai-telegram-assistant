# Токен вашего Telegram бота, можно получить у @BotFather в Telegram
# Пример: 123456789:ABCDEF1234567890abcdef1234567890
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Ваш API ключ от OpenAI, можно получить на https://platform.openai.com/api-keys
# Пример: sk-...
OPENAI_API_KEY=your_openai_api_key_here

# Модель OpenAI, которую будет использовать бот
# По умолчанию: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
